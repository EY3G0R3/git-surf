#!/usr/bin/env bash
# surf — launch the git-surf tmux layout
#
# Usage: surf [session-name] [start-dir]
#        surf --refresh [worktree-dir]
#        surf --close   [worktree-dir]
#        surf --theme <name> [worktree-dir]
#        surf --configure [worktree-dir]
#        surf --themes
#   session-name  defaults to a stable per-worktree name when
#                 $WM_WORKTREE_PATH is set, otherwise "surf"
#   start-dir     defaults to $WM_WORKTREE_PATH when set, otherwise $PWD
#   --refresh     signals an existing matching session to redraw and exits
#   --theme       switches matching live sessions to a named git-log theme
#   --configure   opens a live display-configuration TUI for a Surf session
#   --themes      lists the available git-log themes
#   --close       schedules teardown of the matching sessions and their kitty
#                 tab, then exits immediately. Intended for a workmux
#                 pre_remove hook; see docs/workmux-kitty-tab-close.md.

set -e

# ── Config ────────────────────────────────────────────────────────────────────
HIDE_PANE_BORDER=0        # 1 = invisible border, 0 = default tmux border
BORDER_BG="#282a36"       # terminal background color (used when HIDE_PANE_BORDER=1)
# ─────────────────────────────────────────────────────────────────────────────

MODE=""
case "${1:-}" in
    --refresh|--close|--theme|--themes|--configure) MODE="${1#--}" ;;
esac

SURF_GIT_THEMES=(adaptive-diamond pulse-arrow arrow wide powerline row-yellow row-cyan arrow-hash hash)
SURF_GIT_THEME_DEFAULT=adaptive-diamond

_surf_valid_theme() {
    local candidate="$1" theme
    for theme in "${SURF_GIT_THEMES[@]}"; do
        [[ "$candidate" == "$theme" ]] && return 0
    done
    return 1
}

if [[ "$MODE" == themes ]]; then
    printf '%s\n' "${SURF_GIT_THEMES[@]}"
    exit 0
fi

if [[ "$MODE" == theme ]]; then
    THEME="${2:-}"
    if ! _surf_valid_theme "$THEME"; then
        printf 'surf: unknown theme: %s\n' "${THEME:-<missing>}" >&2
        printf 'available themes: %s\n' "${SURF_GIT_THEMES[*]}" >&2
        exit 2
    fi
    START_DIR="${3:-${WM_WORKTREE_PATH:-$PWD}}"
else
    START_DIR="${2:-${WM_WORKTREE_PATH:-$PWD}}"
fi

# The stable session name for a worktree path.
_surf_session_for_dir() {
    local name id
    name=$(basename "$1")
    id=$(printf '%s' "$1" | cksum | awk '{print $1}')
    printf 'surf-%s-%s' "$name" "$id"
}

# Every live session belonging to a worktree path, one per line. Custom-named
# and legacy sessions cannot be reconstructed from the path, so they are found
# by the start directory they published instead.
_surf_sessions_for_dir() {
    local dir="$1" canonical candidate session_dir
    canonical=$(_surf_session_for_dir "$dir")

    if tmux has-session -t "$canonical" 2>/dev/null; then
        printf '%s\n' "$canonical"
    fi

    while IFS= read -r candidate; do
        [[ -n "$candidate" && "$candidate" != "$canonical" ]] || continue
        session_dir=$(tmux show-environment -t "$candidate" SURF_START_DIR 2>/dev/null \
                      | sed -n 's/^SURF_START_DIR=//p')
        [[ "$session_dir" == "$dir" ]] || continue
        printf '%s\n' "$candidate"
    done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null || true)
}

_surf_set_session_theme() {
    local session="$1" theme="$2"
    tmux set-environment -t "$session" SURF_GIT_THEME "$theme"
    tmux set-environment -t "$session" SURF_REFRESH "$(date +%s%N)"
}

_surf_session_value() {
    local session="$1" name="$2" fallback="$3" value
    value=$(tmux show-environment -t "$session" "$name" 2>/dev/null \
            | sed -n "s/^${name}=//p")
    printf '%s' "${value:-$fallback}"
}

_surf_apply_bottom_config() {
    local session="$1" theme="$2" style="$3" left_separator="$4"
    local right_separator="$5" node="$6" head_node="$7" show_date="$8"
    local show_author="$9" highlight_row="${10}"
    tmux set-environment -t "$session" SURF_GIT_THEME "$theme"
    tmux set-environment -t "$session" SURF_GIT_REF_STYLE "$style"
    tmux set-environment -t "$session" SURF_GIT_SEPARATOR "$left_separator"
    tmux set-environment -t "$session" SURF_GIT_RIGHT_SEPARATOR "$right_separator"
    tmux set-environment -t "$session" SURF_GIT_NODE "$node"
    tmux set-environment -t "$session" SURF_GIT_HEAD_NODE "$head_node"
    tmux set-environment -t "$session" SURF_GIT_SHOW_DATE "$show_date"
    tmux set-environment -t "$session" SURF_GIT_SHOW_AUTHOR "$show_author"
    tmux set-environment -t "$session" SURF_GIT_HIGHLIGHT_ROW "$highlight_row"
    tmux set-environment -t "$session" SURF_REFRESH "$(date +%s%N)"
}

_surf_configure() {
    local session="$1" key rest accepted=0
    local current_theme style left_separator right_separator node head_node
    local show_date show_author highlight_row
    local original_style original_left_separator original_right_separator original_node original_head_node
    local original_show_date original_show_author
    local original_highlight_row
    local -i index=0 i

    [[ -t 0 && -t 1 ]] || {
        printf 'surf: --configure requires an interactive terminal\n' >&2
        return 1
    }

    current_theme=$(_surf_session_value "$session" SURF_GIT_THEME "$SURF_GIT_THEME_DEFAULT")
    style=$(_surf_session_value "$session" SURF_GIT_REF_STYLE text)
    left_separator=$(_surf_session_value "$session" SURF_GIT_SEPARATOR arrow)
    right_separator=$(_surf_session_value "$session" SURF_GIT_RIGHT_SEPARATOR arrow)
    node=$(_surf_session_value "$session" SURF_GIT_NODE star)
    head_node=$(_surf_session_value "$session" SURF_GIT_HEAD_NODE star)
    show_date=$(_surf_session_value "$session" SURF_GIT_SHOW_DATE yes)
    show_author=$(_surf_session_value "$session" SURF_GIT_SHOW_AUTHOR yes)
    highlight_row=$(_surf_session_value "$session" SURF_GIT_HIGHLIGHT_ROW no)
    original_style="$style"
    original_left_separator="$left_separator"
    original_right_separator="$right_separator"
    original_node="$node"
    original_head_node="$head_node"
    original_show_date="$show_date"
    original_show_author="$show_author"
    original_highlight_row="$highlight_row"

    _surf_apply_bottom_config "$session" custom "$style" "$left_separator" \
        "$right_separator" "$node" "$head_node" "$show_date" "$show_author" "$highlight_row"

    _surf_config_cleanup() {
        if [[ "$accepted" -eq 0 ]]; then
            _surf_apply_bottom_config "$session" "$current_theme" "$original_style" \
                "$original_left_separator" "$original_right_separator" "$original_node" \
                "$original_head_node" "$original_show_date" "$original_show_author" \
                "$original_highlight_row" \
                2>/dev/null || true
        fi
        printf '\033[?25h\033[?1049l'
    }
    trap _surf_config_cleanup EXIT
    trap 'exit 130' INT TERM

    _surf_config_display_value() {
        case "$1:$2" in
            left-separator:arrow) printf '%s' '->' ;;
            right-separator:arrow) printf '%s' '<-' ;;
            node:star) printf '%s' '*' ;;
            node:diamond) printf '%s' '◆' ;;
            date:yes|author:yes) printf '%s' show ;;
            date:no|author:no) printf '%s' hide ;;
            highlight:yes) printf '%s' on ;;
            highlight:no) printf '%s' off ;;
            *) printf '%s' "$2" ;;
        esac
    }

    _surf_config_row() {
        local row="$1" setting="$2" label="$3" current="$4" choice display
        shift 4
        if [[ "$row" -eq "$index" ]]; then
            printf '      \033[1;36m›\033[0m %-24s' "$label"
        else
            printf '        %-24s' "$label"
        fi
        for choice in "$@"; do
            display=$(_surf_config_display_value "$setting" "$choice")
            if [[ "$choice" == "$current" && "$row" -eq "$index" ]]; then
                printf ' \033[1;30;46m %-10s \033[0m' "$display"
            elif [[ "$choice" == "$current" ]]; then
                printf ' \033[1;36m[%-10s]\033[0m' "$display"
            else
                printf '  %-10s ' "$display"
            fi
        done
        printf '\n'
    }

    _surf_cycle_value() {
        local current="$1" direction="$2" candidate
        local -a choices=("${@:3}")
        local -i choice_index=0 i
        for (( i = 0; i < ${#choices[@]}; i++ )); do
            [[ "${choices[$i]}" == "$current" ]] && choice_index=$i
        done
        choice_index=$(( (choice_index + direction + ${#choices[@]}) % ${#choices[@]} ))
        REPLY="${choices[$choice_index]}"
    }

    printf '\033[?1049h\033[?25l'
    while true; do
        printf '\033[H\033[2J'
        printf 'Surf display configuration\n'
        printf 'Session: %s\n\n' "$session"
        printf '  TOP PANEL\n'
        printf '    Configuration options coming later.\n\n'
        printf '  MIDDLE PANEL\n'
        printf '    Configuration options coming later.\n\n'
        printf '  BOTTOM PANEL\n'
        printf '    Configurable Git log\n\n'
        _surf_config_row 0 style 'HEAD / branch style' "$style" text powerline
        _surf_config_row 1 left-separator 'Left separator' "$left_separator" arrow none
        _surf_config_row 2 right-separator 'Right separator' "$right_separator" arrow none
        _surf_config_row 3 node 'Regular node' "$node" star diamond
        _surf_config_row 4 node 'HEAD node' "$head_node" star diamond
        _surf_config_row 5 date Date "$show_date" yes no
        _surf_config_row 6 author Author "$show_author" yes no
        _surf_config_row 7 highlight 'Highlight HEAD row' "$highlight_row" no yes
        printf '\n  ↑/↓ select    ←/→ or Space change    Enter keep    q/Esc cancel\n'

        IFS= read -rsn1 key || true
        if [[ "$key" == $'\033' ]]; then
            rest=''
            IFS= read -rsn2 -t 0.05 rest || true
            case "$rest" in
                '[A') key=k ;;
                '[B') key=j ;;
                '[C') key=l ;;
                '[D') key=h ;;
                *) break ;;
            esac
        fi
        case "$key" in
            k)
                index=$(( (index - 1 + 8) % 8 ))
                ;;
            j)
                index=$(( (index + 1) % 8 ))
                ;;
            h|l|' ')
                local direction=1
                [[ "$key" == h ]] && direction=-1
                case "$index" in
                    0) _surf_cycle_value "$style" "$direction" text powerline; style="$REPLY" ;;
                    1) _surf_cycle_value "$left_separator" "$direction" arrow none; left_separator="$REPLY" ;;
                    2) _surf_cycle_value "$right_separator" "$direction" arrow none; right_separator="$REPLY" ;;
                    3) _surf_cycle_value "$node" "$direction" star diamond; node="$REPLY" ;;
                    4) _surf_cycle_value "$head_node" "$direction" star diamond; head_node="$REPLY" ;;
                    5) _surf_cycle_value "$show_date" "$direction" yes no; show_date="$REPLY" ;;
                    6) _surf_cycle_value "$show_author" "$direction" yes no; show_author="$REPLY" ;;
                    7) _surf_cycle_value "$highlight_row" "$direction" no yes; highlight_row="$REPLY" ;;
                esac
                _surf_apply_bottom_config "$session" custom "$style" "$left_separator" \
                    "$right_separator" "$node" "$head_node" "$show_date" "$show_author" \
                    "$highlight_row"
                ;;
            '')
                accepted=1
                break
                ;;
            q) break ;;
            *) continue ;;
        esac
    done
    _surf_config_cleanup
    trap - EXIT INT TERM
}

if [[ -n "$MODE" ]]; then
    SESSION=$(_surf_session_for_dir "$START_DIR")
elif [[ -n "${1:-}" ]]; then
    SESSION="$1"
elif [[ -n "${WM_WORKTREE_PATH:-}" ]]; then
    SESSION=$(_surf_session_for_dir "$START_DIR")
else
    SESSION=surf
fi

if [[ "$MODE" == refresh ]]; then
    refreshed=0
    while IFS= read -r candidate; do
        [[ -n "$candidate" ]] || continue
        tmux set-environment -t "$candidate" SURF_REFRESH "$(date +%s%N)"
        refreshed=1
    done < <(_surf_sessions_for_dir "$START_DIR")

    # Preserve refresh behavior for a non-worktree Surf session created with
    # the historical default name.
    if [[ "$refreshed" -eq 0 && -z "${2:-}" && -z "${WM_WORKTREE_PATH:-}" ]] \
       && tmux has-session -t surf 2>/dev/null; then
        tmux set-environment -t surf SURF_REFRESH "$(date +%s%N)"
    fi
    exit 0
fi

if [[ "$MODE" == theme ]]; then
    switched=0
    while IFS= read -r candidate; do
        [[ -n "$candidate" ]] || continue
        tmux set-environment -t "$candidate" SURF_GIT_THEME "$THEME"
        tmux set-environment -t "$candidate" SURF_REFRESH "$(date +%s%N)"
        switched=1
    done < <(_surf_sessions_for_dir "$START_DIR")

    if [[ "$switched" -eq 0 && -z "${3:-}" && -z "${WM_WORKTREE_PATH:-}" ]] \
       && tmux has-session -t surf 2>/dev/null; then
        tmux set-environment -t surf SURF_GIT_THEME "$THEME"
        tmux set-environment -t surf SURF_REFRESH "$(date +%s%N)"
        switched=1
    fi
    [[ "$switched" -eq 1 ]] || {
        printf 'surf: no matching live session for %s\n' "$START_DIR" >&2
        exit 1
    }
    exit 0
fi

if [[ "$MODE" == configure ]]; then
    CONFIG_SESSION=''
    if [[ -n "${SURF_SESSION:-}" ]] && tmux has-session -t "$SURF_SESSION" 2>/dev/null; then
        CONFIG_SESSION="$SURF_SESSION"
    else
        while IFS= read -r candidate; do
            [[ -n "$candidate" ]] || continue
            CONFIG_SESSION="$candidate"
            break
        done < <(_surf_sessions_for_dir "$START_DIR")
        if [[ -z "$CONFIG_SESSION" && -z "${2:-}" && -z "${WM_WORKTREE_PATH:-}" ]] \
           && tmux has-session -t surf 2>/dev/null; then
            CONFIG_SESSION=surf
        fi
    fi
    [[ -n "$CONFIG_SESSION" ]] || {
        printf 'surf: no matching live session for %s\n' "$START_DIR" >&2
        exit 1
    }
    _surf_configure "$CONFIG_SESSION"
    exit $?
fi

# Quote regex metacharacters so a path can be used as a kitty match expression.
# Without this, "…/foo" would also match the tab for "…/foo-bar", since kitty
# searches rather than anchors.
_surf_regex_escape() {
    printf '%s' "$1" | sed 's/[][^$.*+?{}()|\\]/\\&/g'
}

# Runs detached, after the caller has exited. See the --close block below.
_surf_close_deferred() {
    local dir="$1" listen="$2" sessions="$3"
    local waited=0 pattern candidate
    set +e

    # The worktree directory disappearing is the observable end of workmux's
    # destructive phase, whether it deleted the directory or renamed it to a
    # trash path first. Giving up on timeout leaves the tab and the sessions
    # alone, which is the right outcome when the removal aborted.
    while [[ -e "$dir" ]]; do
        sleep 0.25
        waited=$((waited + 1))
        [[ "$waited" -lt 240 ]] || return 0
    done

    # Close the tab before reaping the sessions. Killing a session first would
    # take down the kitty window carrying the surf_worktree user var, leaving
    # close-tab nothing to match, whereas a tmux session outlives its client
    # and can still be killed afterwards.
    if [[ -n "$listen" ]] && command -v kitten >/dev/null 2>&1; then
        pattern=$(_surf_regex_escape "$dir")
        kitten @ --to "$listen" close-tab \
            --match "var:surf_worktree=^${pattern}\$" >/dev/null 2>&1
    fi

    while IFS= read -r candidate; do
        [[ -n "$candidate" ]] || continue
        tmux kill-session -t "$candidate" >/dev/null 2>&1
    done <<CLOSEEOF
$sessions
CLOSEEOF
}

if [[ "$MODE" == close ]]; then
    # A workmux pre_remove hook runs *before* the worktree is deleted, and
    # usually from inside the very session and tab being torn down. Closing
    # either one synchronously would kill workmux mid-removal, so resolve the
    # targets now, hand them to a detached watcher, and return at once.
    CLOSE_SESSIONS=$(_surf_sessions_for_dir "$START_DIR")

    # $KITTY_LISTEN_ON is correct in every pane, including panes inside tmux;
    # only $KITTY_WINDOW_ID goes stale there. The stashed copy covers callers
    # with no kitty in their environment at all, such as a cron-driven cleanup.
    CLOSE_LISTEN="${KITTY_LISTEN_ON:-}"
    if [[ -z "$CLOSE_LISTEN" && -n "$CLOSE_SESSIONS" ]]; then
        CLOSE_LISTEN=$(tmux show-environment -t "$(printf '%s\n' "$CLOSE_SESSIONS" | head -n1)" \
                       SURF_KITTY_LISTEN 2>/dev/null \
                       | sed -n 's/^SURF_KITTY_LISTEN=//p')
    fi

    # Ignoring SIGHUP and backgrounding inside a subshell that exits at once
    # orphans the watcher onto init, so it survives both the tab closing and
    # the sessions being killed. `setsid` would be tidier but is not portable
    # to macOS.
    ( trap '' HUP
      _surf_close_deferred "$START_DIR" "$CLOSE_LISTEN" "$CLOSE_SESSIONS" &
    ) </dev/null >/dev/null 2>&1
    exit 0
fi

# Resolve symlink installs (for example ~/.local/bin/surf) before locating the
# companion zsh scripts. readlink -f is not available on macOS, so follow the
# chain portably and resolve relative link targets against their link directory.
SURF_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SURF_SOURCE" ]]; do
    SURF_LINK_DIR="$(cd -P "$(dirname "$SURF_SOURCE")" && pwd)"
    SURF_SOURCE="$(readlink "$SURF_SOURCE")"
    [[ "$SURF_SOURCE" == /* ]] || SURF_SOURCE="$SURF_LINK_DIR/$SURF_SOURCE"
done
SURF_DIR="$(cd -P "$(dirname "$SURF_SOURCE")" && pwd)"
SURF_VERSION=$(
    cksum "$SURF_DIR/surf" "$SURF_DIR/zsh/surf-main.zsh" \
        "$SURF_DIR/zsh/surf-top.zsh" "$SURF_DIR/zsh/surf-bot.zsh" \
        | cksum \
        | awk '{print $1}'
)

# Tag the kitty window hosting this session with the worktree it belongs to,
# so `surf --close` can find the tab later.
#
# This has to happen here in the launcher, which is still a direct child of
# kitty, rather than from inside a pane. Panes are spawned by the tmux server
# and inherit the environment the server was started with, so their
# $KITTY_WINDOW_ID names whichever window happened to start the server and goes
# stale the moment that window closes. Re-stamping on every launch also moves
# the tag when a session is reattached in a different window.
_surf_stamp_kitty() {
    [[ -n "${KITTY_LISTEN_ON:-}" && -n "${KITTY_WINDOW_ID:-}" ]] || return 0
    command -v kitten >/dev/null 2>&1 || return 0

    kitten @ --to "$KITTY_LISTEN_ON" set-user-vars \
        --match "id:${KITTY_WINDOW_ID}" \
        "surf_worktree=${START_DIR}" >/dev/null 2>&1 || return 0
    tmux set-environment -t "$SESSION" SURF_KITTY_LISTEN "$KITTY_LISTEN_ON"
    tmux set-environment -t "$SESSION" SURF_KITTY_WINDOW "$KITTY_WINDOW_ID"
}

# ── If session already exists and is healthy (3 panes), just attach ───────
if tmux has-session -t "$SESSION" 2>/dev/null; then
    pane_count=$(tmux list-panes -t "${SESSION}:0" 2>/dev/null | wc -l)
    if [[ "$pane_count" -eq 3 ]]; then
        session_dir=$(tmux show-environment -t "$SESSION" SURF_PWD 2>/dev/null \
                      | sed 's/^SURF_PWD=//')
        session_version=$(tmux show-environment -t "$SESSION" SURF_VERSION 2>/dev/null \
                          | sed 's/^SURF_VERSION=//')
        if [[ "$session_dir" == "$START_DIR" && "$session_version" == "$SURF_VERSION" ]]; then
            _surf_stamp_kitty
            exec tmux attach-session -t "$SESSION"
        fi
    fi

    # A stale session carries old code or pane state. Rebuild it instead of
    # attaching and continuing to show an obsolete directory (commonly "/").
    tmux kill-session -t "$SESSION" 2>/dev/null || true
fi

TERM_LINES=$(tput lines 2>/dev/null || true)
TERM_COLS=$(tput cols 2>/dev/null || true)
[[ ${TERM_LINES:-0} -lt 10 ]] && TERM_LINES=24
[[ ${TERM_COLS:-0}  -lt 20 ]] && TERM_COLS=80
BOT_LINES=$(( TERM_LINES * 30 / 100 ))
[[ $BOT_LINES -lt 5 ]] && BOT_LINES=5
GIT_LOG_LINES=$(( BOT_LINES - 2 ))
[[ $GIT_LOG_LINES -lt 3 ]] && GIT_LOG_LINES=3
TOP_LINES=4

# ── Create session + split ─────────────────────────────────────────────────
tmux new-session -d -s "$SESSION" \
    -x "$TERM_COLS" -y "$TERM_LINES" \
    -c "$START_DIR"
tmux set -t "$SESSION" status off
if [[ "$HIDE_PANE_BORDER" == 1 ]]; then
    tmux set -t "$SESSION" pane-border-style "fg=${BORDER_BG}"
    tmux set -t "$SESSION" pane-active-border-style "fg=${BORDER_BG}"
else
    tmux set -t "$SESSION" pane-border-style fg=default
    tmux set -t "$SESSION" pane-active-border-style fg=default
fi

# Capture the original pane before splitting so pane-index renumbering cannot
# change which shell becomes the interactive main pane.
MAIN_PANE=$(tmux display-message -t "${SESSION}:0.0" -p "#{pane_id}")

# Split off bottom 30 % (git log), then a small status pane above the main
# shell. The status process resizes itself between 4 and 10 rows as needed.
BOT_PANE=$(tmux split-window -v -l "$BOT_LINES" -t "$MAIN_PANE" \
    -c "$START_DIR" -P -F "#{pane_id}")
TOP_PANE=$(tmux split-window -v -b -l "$TOP_LINES" -t "$MAIN_PANE" \
    -c "$START_DIR" -P -F "#{pane_id}")

# Layout:
#   top   worktree status (4–10 rows)
#   main  normal interactive zsh (remaining space)
#   bot   git log (~30 %)

# ── Publish shared state into session environment ─────────────────────────
tmux set-environment -t "$SESSION" SURF_MAIN_PANE "$MAIN_PANE"
tmux set-environment -t "$SESSION" SURF_TOP_PANE  "$TOP_PANE"
tmux set-environment -t "$SESSION" SURF_BOT_PANE  "$BOT_PANE"
tmux set-environment -t "$SESSION" SURF_SESSION   "$SESSION"
tmux set-environment -t "$SESSION" SURF_DIR       "$SURF_DIR"
tmux set-environment -t "$SESSION" SURF_VERSION   "$SURF_VERSION"
tmux set-environment -t "$SESSION" SURF_GIT_LINES "$GIT_LOG_LINES"
tmux set-environment -t "$SESSION" SURF_START_DIR  "$START_DIR"
tmux set-environment -t "$SESSION" SURF_PWD       "$START_DIR"
tmux set-environment -t "$SESSION" SURF_GIT_THEME \
    "${SURF_GIT_THEME:-$SURF_GIT_THEME_DEFAULT}"
_surf_stamp_kitty

# The interactive middle pane owns the session. Closing it should not leave
# the status and log workers behind in an otherwise unusable tab.
tmux set-hook -t "$SESSION" pane-exited \
    "if-shell -F '#{==:#{hook_pane},$MAIN_PANE}' 'kill-session -t $SESSION'"

# ── Bootstrap each pane by sourcing a generated script ────────────────────
_launch_pane() {
    local pane="$1"
    local role="$2"

    local bootstrap quoted_start_dir
    bootstrap=$(mktemp -t "surf-${role}-XXXXXX.zsh")
    printf -v quoted_start_dir '%q' "$START_DIR"

    cat > "$bootstrap" <<RCEOF
export SURF_MAIN_PANE="$MAIN_PANE"
export SURF_TOP_PANE="$TOP_PANE"
export SURF_BOT_PANE="$BOT_PANE"
export SURF_SESSION="$SESSION"
export SURF_DIR="$SURF_DIR"
export SURF_GIT_LINES="$GIT_LOG_LINES"
export SURF_START_DIR="$START_DIR"
export SURF_PWD="$START_DIR"
export SURF_GIT_THEME="${SURF_GIT_THEME:-$SURF_GIT_THEME_DEFAULT}"
export SURF_ROLE="$role"
export SURF_SOURCED=1
cd -- $quoted_start_dir
source "$SURF_DIR/zsh/surf-${role}.zsh"
RCEOF

    tmux send-keys -t "$pane" \
        "source $(printf '%q' "$bootstrap")" \
        Enter
}

_launch_pane "$MAIN_PANE" main
_launch_pane "$TOP_PANE"  top
_launch_pane "$BOT_PANE"  bot

# ── Focus main pane and attach ────────────────────────────────────────────
tmux select-pane -t "$MAIN_PANE"
exec tmux attach-session -t "$SESSION"
