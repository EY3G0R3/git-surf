#!/usr/bin/env bash
# surf — launch the git-surf tmux layout
#
# Usage: surf [session-name] [start-dir]
#   session-name  defaults to a stable per-worktree name when
#                 $WM_WORKTREE_PATH is set, otherwise "surf"
#   start-dir     defaults to $WM_WORKTREE_PATH when set, otherwise $PWD

set -e

# ── Config ────────────────────────────────────────────────────────────────────
HIDE_PANE_BORDER=0        # 1 = invisible border, 0 = default tmux border
BORDER_BG="#282a36"       # terminal background color (used when HIDE_PANE_BORDER=1)
# ─────────────────────────────────────────────────────────────────────────────

START_DIR="${2:-${WM_WORKTREE_PATH:-$PWD}}"
if [[ -n "${1:-}" ]]; then
    SESSION="$1"
elif [[ -n "${WM_WORKTREE_PATH:-}" ]]; then
    WORKTREE_NAME=$(basename "$START_DIR")
    WORKTREE_ID=$(printf '%s' "$START_DIR" | cksum | awk '{print $1}')
    SESSION="surf-${WORKTREE_NAME}-${WORKTREE_ID}"
else
    SESSION=surf
fi

# Resolve symlink installs (for example ~/.local/bin/surf) before locating the
# companion zsh scripts. readlink -f is not available on macOS, so follow the
# chain portably and resolve relative link targets against their link directory.
SURF_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SURF_SOURCE" ]]; do
    SURF_LINK_DIR="$(cd -P "$(dirname "$SURF_SOURCE")" && pwd)"
    SURF_SOURCE="$(readlink "$SURF_SOURCE")"
    [[ "$SURF_SOURCE" == /* ]] || SURF_SOURCE="$SURF_LINK_DIR/$SURF_SOURCE"
done
SURF_DIR="$(cd -P "$(dirname "$SURF_SOURCE")" && pwd)"
SURF_VERSION=$(
    cksum "$SURF_DIR/surf" "$SURF_DIR/zsh/surf-main.zsh" "$SURF_DIR/zsh/surf-bot.zsh" \
        | cksum \
        | awk '{print $1}'
)

# ── If session already exists and is healthy (2 panes), just attach ───────
if tmux has-session -t "$SESSION" 2>/dev/null; then
    pane_count=$(tmux list-panes -t "${SESSION}:0" 2>/dev/null | wc -l)
    if [[ "$pane_count" -ge 2 ]]; then
        session_dir=$(tmux show-environment -t "$SESSION" SURF_PWD 2>/dev/null \
                      | sed 's/^SURF_PWD=//')
        session_version=$(tmux show-environment -t "$SESSION" SURF_VERSION 2>/dev/null \
                          | sed 's/^SURF_VERSION=//')
        if [[ "$session_dir" == "$START_DIR" && "$session_version" == "$SURF_VERSION" ]]; then
            exec tmux attach-session -t "$SESSION"
        fi
    fi

    # A stale session carries old code or pane state. Rebuild it instead of
    # attaching and continuing to show an obsolete directory (commonly "/").
    tmux kill-session -t "$SESSION" 2>/dev/null || true
fi

TERM_LINES=$(tput lines 2>/dev/null || true)
TERM_COLS=$(tput cols 2>/dev/null || true)
[[ ${TERM_LINES:-0} -lt 10 ]] && TERM_LINES=24
[[ ${TERM_COLS:-0}  -lt 20 ]] && TERM_COLS=80
BOT_LINES=$(( TERM_LINES * 30 / 100 ))
[[ $BOT_LINES -lt 5 ]] && BOT_LINES=5
GIT_LOG_LINES=$(( BOT_LINES - 2 ))
[[ $GIT_LOG_LINES -lt 3 ]] && GIT_LOG_LINES=3

# ── Create session + split ─────────────────────────────────────────────────
tmux new-session -d -s "$SESSION" \
    -x "$TERM_COLS" -y "$TERM_LINES" \
    -c "$START_DIR"
tmux set -t "$SESSION" status off
if [[ "$HIDE_PANE_BORDER" == 1 ]]; then
    tmux set -t "$SESSION" pane-border-style "fg=${BORDER_BG}"
    tmux set -t "$SESSION" pane-active-border-style "fg=${BORDER_BG}"
else
    tmux set -t "$SESSION" pane-border-style fg=default
    tmux set -t "$SESSION" pane-active-border-style fg=default
fi

# Split off bottom 30 % (git log)
tmux split-window -v -l "$BOT_LINES" -t "${SESSION}:0.0" -c "$START_DIR"

# Layout:
#   0.0  main shell  (~70 %) — normal interactive zsh, input + output
#   0.1  bot git log ( 30 %)

MAIN_PANE=$(tmux display-message -t "${SESSION}:0.0" -p "#{pane_id}")
BOT_PANE=$(tmux display-message  -t "${SESSION}:0.1" -p "#{pane_id}")

# ── Publish shared state into session environment ─────────────────────────
tmux set-environment -t "$SESSION" SURF_MAIN_PANE "$MAIN_PANE"
tmux set-environment -t "$SESSION" SURF_BOT_PANE  "$BOT_PANE"
tmux set-environment -t "$SESSION" SURF_SESSION   "$SESSION"
tmux set-environment -t "$SESSION" SURF_DIR       "$SURF_DIR"
tmux set-environment -t "$SESSION" SURF_VERSION   "$SURF_VERSION"
tmux set-environment -t "$SESSION" SURF_GIT_LINES "$GIT_LOG_LINES"
tmux set-environment -t "$SESSION" SURF_START_DIR  "$START_DIR"
tmux set-environment -t "$SESSION" SURF_PWD       "$START_DIR"

# ── Bootstrap each pane by sourcing a generated script ────────────────────
_launch_pane() {
    local pane="$1"
    local role="$2"

    local bootstrap quoted_start_dir
    bootstrap=$(mktemp -t "surf-${role}-XXXXXX.zsh")
    printf -v quoted_start_dir '%q' "$START_DIR"

    cat > "$bootstrap" <<RCEOF
export SURF_MAIN_PANE="$MAIN_PANE"
export SURF_BOT_PANE="$BOT_PANE"
export SURF_SESSION="$SESSION"
export SURF_DIR="$SURF_DIR"
export SURF_GIT_LINES="$GIT_LOG_LINES"
export SURF_START_DIR="$START_DIR"
export SURF_PWD="$START_DIR"
export SURF_ROLE="$role"
export SURF_SOURCED=1
cd -- $quoted_start_dir
source "$SURF_DIR/zsh/surf-${role}.zsh"
RCEOF

    tmux send-keys -t "$pane" \
        "source $(printf '%q' "$bootstrap")" \
        Enter
}

_launch_pane "$MAIN_PANE" main
_launch_pane "$BOT_PANE"  bot

# ── Focus main pane and attach ────────────────────────────────────────────
tmux select-pane -t "$MAIN_PANE"
exec tmux attach-session -t "$SESSION"
